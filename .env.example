# Copy to .env for local development. On Render, add these under Environment.
APP_ENV=production
PORT=10000
CORS_ORIGIN=https://your-user-app-domain.example,https://your-admin-app-domain.example

# Required backend/admin authentication
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD

# Turso/libSQL database (this is the app's database)
TURSO_DATABASE_URL=libsql://YOUR-DATABASE-YOUR-ORG.turso.io
TURSO_AUTH_TOKEN=PASTE_TURSO_DATABASE_AUTH_TOKEN

# Firebase Admin SDK (server-side only; used for FCM server operations)
# Firebase is NOT the Turso database. These credentials do not configure Firestore.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_PRIVATE_KEY_BODY_HERE\n-----END PRIVATE KEY-----\n"

# AI provider credentials — placeholders only; AI image worker is NOT implemented in this starter
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=

# Private S3-compatible object storage — placeholders only; upload/download adapter is NOT implemented
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
